# ==============================================================================
# CivicAdmin Administrative Service - Environment Variables Template
# Copy this file to .env and adjust variables for your target deployment.
# ==============================================================================

# Application Environment ('development' | 'production')
ENVIRONMENT=development

# Core API Security
# IMPORTANT: Generate a secure cryptographic string of at least 32 characters in production
SECRET_KEY=super-secret-development-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration
# Local development default: SQLite
DATABASE_URL=sqlite:///./civic_admin.db
# Docker Compose / PostgreSQL default:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicadmin_db

# Initial Development Administrator Bootstrap
# These credentials will be provisioned on first launch if no administrator account exists.
INITIAL_ADMIN_EMAIL=admin@civicportal.gov
INITIAL_ADMIN_PASSWORD=AdminPass123!@#

# Docker Compose Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=civicadmin_db

# Frontend API Gateway Integration URL (for Vite)
# Default during Phase 1: Direct backend microservice URL
VITE_API_URL=http://localhost:8000/api/v1
