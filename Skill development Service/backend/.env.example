# ==============================================================================
# NAGRIKSETU SKILL DEVELOPMENT MICROSERVICE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# INSTRUCTIONS FOR DEVELOPERS / INTEGRATORS:
# 1. Copy this file to .env before starting the service:
#      cp .env.example .env
# 2. Fill in all placeholder values with your specific environment credentials.
# 3. Import database/skill_db_backup.sql into a dedicated, isolated database
#    (e.g., skill_db or nagriksetu_skill_service). NEVER import into a shared DB!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dedicated MySQL Database Configuration (Isolated Database)
# ------------------------------------------------------------------------------
# For local host execution, host is 127.0.0.1; for Docker, host.docker.internal
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_DATABASE=skill_db
MYSQL_USER=nagriksetu_skill
MYSQL_PASSWORD=your_mysql_password_here

# Optional: Full connection string override (takes precedence if provided)
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3308/skill_db

# ------------------------------------------------------------------------------
# 2. Security & Authentication Configuration
# ------------------------------------------------------------------------------
# Minimum 32-character secure random string. The server will reject startup if left as default placeholder.
JWT_SECRET=replace_with_your_own_secure_random_jwt_secret_min_32_chars

# Skill Department Admin Initial Account
ADMIN_EMAIL=skill.admin@nagriksetu.local
ADMIN_PASSWORD=your_secure_admin_password_here

# ------------------------------------------------------------------------------
# 3. Skill Development Service Configuration
# ------------------------------------------------------------------------------
SKILL_BACKEND_PORT=8003
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8003

# Toggle automatic schema creation on startup (Default: false - use Alembic migrations)
ENABLE_AUTO_CREATE_TABLES=false

# ------------------------------------------------------------------------------
# 4. RabbitMQ Message Broker Configuration
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=nagriksetu
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password_here
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ------------------------------------------------------------------------------
# 5. Downstream Integration Adapters
# ------------------------------------------------------------------------------
EMPLOYMENT_SERVICE_URL=http://127.0.0.1:8002

# ------------------------------------------------------------------------------
# 6. Test Suite Configuration (Isolated Test Database)
# ------------------------------------------------------------------------------
# The automated test harness strictly enforces testing against skill_test_db only.
TEST_DATABASE_URL=mysql+pymysql://nagriksetu_skill:your_mysql_password_here@127.0.0.1:3308/skill_test_db
