# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=skill-root-secure-pass
MYSQL_DATABASE=skill_db
MYSQL_USER=nagriksetu_skill
MYSQL_PASSWORD=skill-app-pass-2026
