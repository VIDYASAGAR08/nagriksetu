ADMIN_PASSWORD=SkillAdmin@2026!

# Network & Ports
SKILL_BACKEND_PORT=8003
SKILL_FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8003

# External Microservice Endpoints (As per NagrikSetu Microservice Ownership)
