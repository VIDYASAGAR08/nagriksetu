DATABASE_URL=mysql+pymysql://nagriksetu_skill:skill-app-pass-2026@127.0.0.1:3308/skill_db

# RabbitMQ Event Integration
RABBITMQ_DEFAULT_USER=nagriksetu
RABBITMQ_DEFAULT_PASS=rabbitmq-pass-2026
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://nagriksetu:rabbitmq-pass-2026@127.0.0.1:5672/

# Security & Authentication
JWT_SECRET=nagriksetu-skill-super-secret-key-2026-xyz-32char
