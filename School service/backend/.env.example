# NagrikSetu School Service Environment Variables Example

# Database & Authentication
DATABASE_PATH=/app/data/nagriksetu.db
JWT_SECRET_KEY=generate_a_secure_jwt_secret_key_here
OTP_SALT=nagriksetu_secure_otp_salt_v1

# SMS Gateway Provider Selection
# Options:
#   mock   - Student project development mode (simulated SMS, no OTP.dev credits consumed, displays dev notice & dev OTP)
#   otpdev - Production real SMS delivery via OTP.dev API
#   msg91  - Production real SMS delivery via MSG91 API
OTP_PROVIDER=mock
SMS_PROVIDER=mock

# Real SMS Gateway Configuration (OTP.dev - used when OTP_PROVIDER=otpdev)
OTPDEV_API_KEY=YOUR_EXISTING_OTPDEV_API_KEY
OTPDEV_SENDER_ID=YOUR_EXISTING_SENDER_UUID
OTPDEV_SMS_TEMPLATE_ID=YOUR_EXISTING_TEMPLATE_UUID

# Email Service Configuration (SMTP)
# Enter your SMTP server details below for email registration & password resets:
EMAIL_PROVIDER=smtp
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@nagriksetu.karnataka.gov.in
SMTP_FROM_NAME=NagrikSetu

SMS_ENVIRONMENT=development

# Google Identity Services / OAuth Configuration
# Enter your Google OAuth Client ID from Google Cloud Console:
# Authorized JavaScript Origins: http://localhost:5173
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
